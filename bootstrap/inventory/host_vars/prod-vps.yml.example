---
# =============================================================================
# inventory/host_vars/prod-vps.yml.example — шаблон параметров боевого хоста.
# =============================================================================
#
# ЧТО ЭТО.
# Ansible ищет файл host_vars/<host>.yml для каждого хоста из hosts.yml и
# подгружает оттуда переменные ПЕРСОНАЛЬНЫЕ для этого хоста: IP, пользователь,
# путь к SSH-ключу, особые override'ы. Magic-переменные с префиксом `ansible_*`
# управляют тем, КАК именно Ansible подключается к серверу. Обычные переменные
# (если бы тут были) перебивали бы значения из group_vars/all.yml.
#
# КАК С ЭТИМ РАБОТАТЬ.
# 1. Скопируй этот файл в prod-vps.yml (без .example) — он рядом в каталоге.
# 2. Подставь реальные значения.
# 3. Реальный prod-vps.yml в репо НЕ попадает (см. bootstrap/.gitignore) —
#    в нём пути и IP конкретно твоей машины.
#
# КАК СВЯЗАН С ДРУГИМИ ФАЙЛАМИ.
# - Имя файла (prod-vps) должно совпадать с именем хоста из hosts.yml.
# - playbooks/bootstrap.yml использует эти переменные, когда Ansible
#   решает, КУДА подключаться для хоста prod-vps.

# IP-адрес или DNS-имя боевого VPS. Ansible подставит это в ssh-команду.
ansible_host: REPLACE_ME_WITH_VPS_IP

# Под каким пользователем Ansible заходит на VPS. Только что созданный VPS
# у публичных провайдеров (Hetzner, DigitalOcean, weasel.cloud и т.п.)
# обычно отдаёт root с ключом из панели или cloud-init. Если провайдер
# выдаёт другого юзера (например, `ubuntu`) — подставь его сюда.
ansible_user: root

# Путь к локальному private-key (на твоей машине), парный публичному ключу,
# который провайдер положил в authorized_keys VPS при создании.
# Тильда `~` Ansible сам разворачивает в $HOME.
ansible_ssh_private_key_file: ~/.ssh/id_ed25519
