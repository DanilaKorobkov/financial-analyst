# Переменные окружения приложения financial-analyst. Все обязательны.

# --- MOEX (источник рыночных данных) ---

# Корень MOEX ISS API без завершающего слэша.
MOEX_BASE_URL=https://iss.moex.com/iss

# Таймаут на один HTTP-запрос к MOEX ISS.
MOEX_TIMEOUT=10s

# --- Connect-сервер ---

# TCP-порт, который слушает сервер.
SERVER_PORT=8080

# --- FinanceMarker (понадобится на следующих шагах; runtime пока не использует) ---

FINANCE_MARKER_TOKEN=
