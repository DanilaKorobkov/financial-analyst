# If you prefer the allow list template instead of the deny list, see community template:
# https://github.com/github/gitignore/blob/main/community/Golang/Go.AllowList.gitignore
#
# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Code coverage profiles and other test artifacts
*.out
coverage.*
*.coverprofile
profile.cov

# Dependency directories (remove the comment below to include it)
# vendor/

# Go workspace file
go.work
go.work.sum

# env file
.env

# Editor/IDE
# .idea/
# .vscode/

# Кеш lychee — локальный результат прошлого прогона чекера ссылок.
.lycheecache

# Временные каталоги переиспользуемой задачи snippets:diff-generated
# (см. taskfile-snippets.yml). Очищаются trap-ом, но могут остаться при
# аварийном завершении.
.diff-generated.*/

# Per-worktree кэши golangci-lint и go-build. Привязаны к корню worktree
# через mise.toml [env] (GOLANGCI_LINT_CACHE, GOCACHE) — см. там обоснование.
.golangci-cache/
.gocache/

# Файловый кеш карточек эмитентов (internal/infra/filecache/companycard
# поверх diskv). Локальный артефакт рантайма, в репозиторий не уезжает.
.cache/

# npm-зависимости фронта (web/node_modules) и его dev-артефакты.
node_modules/
web/dist/
web/.vite/
